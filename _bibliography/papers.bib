@article{agrawal2025ambientai,
  bibtex_show = {false},
  abbr        = {IoT For All},
  author       = {Amod K. Agrawal},
  title        = {Enabling Ambient AI with Wearables and AIoT},
  abstract    = {Artificial intelligence is beginning to move beyond text and screen-based systems into devices that sense and respond to the physical world. Wearable technologies such as smart glasses, earbuds, and watches can provide continuous information about the user, while sensors in the environment can detect presence and activity. Together, these systems create opportunities for AI that is proactive, context-aware, and able to support daily life in real time. This article examines how wearables and ambient sensing can work together, the challenges of processing data locally versus in the cloud, and the importance of addressing privacy and trust. The convergence of wearables, ubiquitous sensing, and agentic AI marks a critical step toward realizing the vision of ambient AI.},
