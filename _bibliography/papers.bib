@inproceedings{billah2026iotell,
  bibtex_show = {true},
  abbr      = {ACM MobiHoc '26},
  author    = {Md Fazlay Masum Rabbi Billah and Amod K. Agrawal and Viswajith Govinda Rajan and Brad Campbell},
  title     = {IoTell: Multimodal Sensor Fusion for Enhanced IoT Control},
  abstract  = {Current control interfaces between a user and a network of heterogeneous IoT devices largely consist of device-specific applications or voice commands with a fixed set of instructions for each device. Such control mechanisms fail to cope with the vision of dense trillion-node IoT network, where users would interact with tens of smart devices in everyday environments. Recent advances in RF-based ranging technologies enable accurate estimation of user location in indoor environments. However, leveraging this spatial context to enable intuitive interaction remains an open challenge, particularly in dense deployments where multiple candidate devices exist within close proximity. In this paper, we introduce IoTell, an intuitive control interface that allows users to interact with a device by pointing to it and issuing simple voice commands. IoTell fuses location, orientation, and voice instructions to identify the intended device without requiring explicit device naming. Operating in device-dependent mode, the system estimates user location and orientation through a wearable device using RF-based localization and inertial sensing. In the device-independent mode, IoTell enables the user to have a similar experience even when the user may not carry a wearable, by estimating user location and orientation through multimodal fusion of audio and RF signal features. We implement IoTell using a UWB-based localization system and inertial sensing on a wearable device, and evaluate its performance in a multi-device indoor environment. Our experiments demonstrate that IoTell achieves 95.2% accuracy in correctly executing commands in device-dependent settings and 88.3% accuracy, with a mean localization error of 45 cm, in device-independent scenarios. These results show that multimodal fusion of spatial and linguistic context can significantly improve interaction with IoT systems under realistic conditions.},
  booktitle = {Proceedings of the 27th International Symposium on Theory, Algorithmic Foundations, and Protocol Design for Mobile Networks and Mobile Computing (MobiHoc '26)},
  month     = November,
  year      = {2026},
  location  = {Tokyo, Japan},
  publisher = {ACM},
  address   = {New York, NY, USA},
  note      = {Accepted August 23, 2026}
}

@inproceedings{agrawal2026headsense,
  bibtex_show = {true},
  abbr      = {ACM HumanSys (MobiCom '26)},
  author    = {Amod K. Agrawal and Ashutosh Dhekne and Romit Roy Choudhury},
  title     = {HeadSense: Head Orientation Tracking for AI Wearables using Ultra-Wideband Ranging},
  abstract  = {AI wearables (smart glasses, pins, pendants, and earbuds) use head gestures for interaction, yet lack a reliable, continuous measure of head-to-torso orientation. Such a measurement would enable temporal attention context for AI assistants, allowing them to infer sustained visual attention, disambiguate spatial commands, and filter out incidental head movements. IMU-based tracking drifts over time, limiting it to transient gesture detection such as nods and shakes. Magnetometer-based yaw correction fails indoors near ferrous materials and speaker magnets common in wearable devices. We present HeadSense, a necklace-like wearable that uses ultra-wideband (UWB) radios to continuously track head orientation relative to the torso with bounded, non-accumulating error. HeadSense introduces a wired reference path between chest-mounted transmitters and head-worn receivers, enabling relative time-of-flight measurements with sub-centimeter precision. A four-stage signal processing pipeline combines channel impulse response (CIR) interpolation, template matching, phase refinement, and IMU-based ambiguity resolution to reduce the typical 10 cm UWB ranging error to a median of 5 mm and achieve a median orientation error of 6.5°, validated against Vicon motion capture ground truth. HeadSense provides an infrastructure-free, body-centric orientation sensing capability for AI wearables without requiring cameras or external tracking systems.},
  booktitle = {Proceedings of the International Workshop on Human-Centered Sensing, Modeling, and Intelligent Systems (HumanSys '26), co-located with ACM MobiCom 2026},
  month     = August,
  year      = {2026},
  location  = {Austin, TX, USA},
  publisher = {ACM},
  address   = {New York, NY, USA},
  note      = {Accepted August 14, 2026}
}

@inproceedings{agrawal2026homelm,
  bibtex_show = {true},
  abbr      = {ACM HumanSys (MobiCom '26)},
  author    = {Amod K. Agrawal},
  title     = {Vision: HomeLM for Ambient Intelligence in the Smart Home},
  abstract  = {Smart homes hold abundant sensing opportunities, from microphone arrays and presence radars to wearables and everyday device interactions. These modalities rarely add up to a coherent picture of what is happening inside the home. Today's ambient intelligence stitches together many narrow, task-specific models but lacks a unified semantic understanding of the signals they consume. We envision HomeLM, a foundation model that learns to align home-sensing signals with natural language, so that a single model can describe and reason about human activity across a whole house rather than classifying it one task at a time. This would let a home recognize situations it was never explicitly trained for and act proactively on behalf of its occupants. This paper outlines our vision for HomeLM: how such a model could be trained, the research challenges in realizing it, and the opportunities it brings for the smart home.},
  booktitle = {Proceedings of the International Workshop on Human-Centered Sensing, Modeling, and Intelligent Systems (HumanSys '26), co-located with ACM MobiCom 2026},
  month     = August,
  year      = {2026},
  location  = {Austin, TX, USA},
  publisher = {ACM},
  address   = {New York, NY, USA},
  note      = {Accepted August 14, 2026}
}

@article{garcia2018collective,
  bibtex_show = {true},
  abbr        = {Springer EPJ Data Science},
  title       = {Collective aspects of privacy in the online network},
  author      = {David Garcia and Mansi Goel and Amod K. Agrawal and Ponnurangam Kumaraguru},
  abstract    = {Preserving individual control over private information is one of the rising concerns in our digital society. Online social networks exist in application ecosystems that allow them to access data from other services, for example gathering contact lists through mobile phone applications. Such data access might allow social networking sites to create shadow profiles with information about non-users that has been inferred from information shared by the users of the social network. This possibility motivates the shadow profile hypothesis: the data shared by the users of an online service predicts personal information of non-users of the service. We test this hypothesis for the first time on Twitter, constructing a dataset of users that includes profile biographical text, location information, and bidirectional friendship links. We evaluate the predictability of the location of a user by using only information given by friends of the user that joined Twitter before the user did. This way, we audit the historical prediction power of Twitter data for users that had not joined Twitter yet. Our results indicate that information shared by users in Twitter can be predictive of the location of individuals outside Twitter. Furthermore, we observe that the quality of this prediction increases with the tendency of Twitter users to share their mobile phone contacts and is more accurate for individuals with more contacts inside Twitter. We further explore the predictability of biographical information of non-users, finding evidence in line with our results for locations. These findings illustrate that individuals are not in full control of their online privacy and that sharing personal data with a social networking site is a decision that is collectively mediated by the decisions of others.},
  journal     = {EPJ Data Science},
  volume      = {7},
  number      = {1},
  pages       = {1--13},
  month       = January,
  year        = {2018},
  publisher   = {SpringerOpen},
  doi         = {10.1140/epjds/s13688-018-0130-3},
  google_scholar_id = {9yKSN-GCB0IC}
}

@article{veit2015optimizing,
  bibtex_show = {true},
  abbr        = {AAAI HCOMP'15},
  title       = {On optimizing human-machine task assignments},
  author      = {Andreas Veit and Michael Wilber and Rajan Vaish and Serge Belongie and James Davis and Vishal Anand and Anshu Aviral and Prithvijit Chakrabarty and Yash Chandak and Sidharth Chaturvedi and Chinmaya Devaraj and Ankit Dhall and Utkarsh Dwivedi and Sanket Gupte and Sharath N Sridhar and Karthik Paga and Anuj Pahuja and Aditya Raisinghani and Ayush Sharma and Shweta Sharma and Darpana Sinha and Nisarg Thakkar and K Bala Vignesh and Utkarsh Verma and Kanniganti Abhishek and Amod K. Agrawal and Arya Aishwarya and Aurgho Bhattacharjee and Sarveshwaran Dhanasekar and Venkata Karthik Gullapalli and Shuchita Gupta and Kinjal Jain and Simran Kapur and Meghana Kasula and Shashi Kumar and Parth Kundaliya and Utkarsh Mathur and Alankrit Mishra and Aayush Mudgal and Aditya Nadimpalli and Munakala Sree Nihit and Akanksha Periwal and Ayush Sagar and Ayush Shah and Vikas Sharma and Yashovardhan Sharma and Faizal Siddiqui and Virender Singh and Anurag Yadav},
  abstract    = {When crowdsourcing systems are used in combination with machine inference systems in the real world, they benefit the most when the machine system is deeply integrated with the crowd workers. However, if researchers wish to integrate the crowd with "off-the-shelf" machine classifiers, this deep integration is not always possible. This work explores two strategies to increase accuracy and decrease cost under this setting. First, we show that reordering tasks presented to the human can create a significant accuracy improvement. Further, we show that greedily choosing parameters to maximize machine accuracy is sub-optimal, and joint optimization of the combined system improves performance.},
  journal     = {AAAI Conference on Conference on Human Computation and Crowdsourcing, HCOMP '15},
  month       = September,
  year        = {2015},
  arxiv       = {1509.07543},
  doi         = {10.48550/arXiv.1509.07543},
  note        = {Work-in-Progress Posters and Demonstration, Tech Report CR-15-01},
  google_scholar_id = {u5HHmVD_uO8C}
}

@MastersThesis{agrawal2019headtrack,
  bibtex_show = {true},
  abbr        = {M.S. Thesis},
  title       = {HeadTrack: Tracking Head Orientation Using Wireless Signals},
  author      = {Amod K. Agrawal and Romit Roy Choudhury},
  abstract    = {Estimating and tracking a user's head orientation is critical for many mobile computing applications. Existing solutions typically rely on infrastructure-based setups, such as cameras or lasers, combined with expensive inertial measurement units (IMUs). These approaches constrain the user to a fixed area and limit both portability and mobility. This work introduces HeadTrack, a necklace-style wearable consisting of a headset and a chest-piece, which estimates head orientation using wireless radio frequency (RF) signals. The core challenge addressed is to accurately measure multiple distances between the chest-mounted unit and the headset using ultra-wideband (UWB) radios. By decoupling head motion from body motion, this design enables both mobility and portability. Although UWB radios offer 1 GHz bandwidth and high-speed clocks, they typically achieve only ~10 cm ranging accuracy. HeadTrack improves this to ~5 mm by introducing a wired reference path. The transmitted signal is split and sent over both wired and wireless paths, allowing more precise distance estimation. For evaluation, we use ViCon to collect ground truth data. HeadTrack leverages an onboard IMU to resolve phase ambiguity and achieves head orientation tracking with a mean error of 6.5°. The system offers a wearable, occlusion-free, cost-effective solution for head orientation tracking with bounded and non-diverging error.},
  school      = {University of Illinois at Urbana-Champaign},
  month       = April,
  year        = {2019},
  doi         = {http://hdl.handle.net/2142/105242},
  slides      = {https://docs.google.com/presentation/d/17jNVJ3b6a4ipYhrE-_DJlkFnuON85y7H/edit?usp=sharing&ouid=117522527622684919145&rtpof=true&sd=true}
}

@inproceedings{agrawal2025aoa,
  bibtex_show = {true},
  abbr      = {ACM EnvSys (MobiSys '25)},
  author    = {Amod K. Agrawal},
  title     = {Localization using Angle-of-Arrival Triangulation},
  abstract  = {Indoor localization is a long-standing challenge in mobile computing, with significant implications for enabling location-aware and intelligent applications within smart environments such as homes, offices, and retail spaces. As AI assistants such as Amazon Alexa and Google Nest become increasingly pervasive, microphone-equipped devices are emerging as key components of everyday life and home automation. This paper introduces a passive, infrastructure-light system for localizing human speakers using speech signals captured by two or more spatially distributed smart devices. The proposed approach, GCC+, extends the Generalized Cross-Correlation with Phase Transform (GCC-PHAT) method to estimate the Angle-of-Arrival (AoA) of audio signals at each device and applies robust triangulation techniques to infer the speaker’s two-dimensional position. To further improve temporal resolution and localization accuracy, feature-space expansion and subsample interpolation techniques are employed for precise Time Difference of Arrival (TDoA) estimation. The system operates without requiring hardware modifications, prior calibration, explicit user cooperation, or knowledge of the speaker’s signal content, thereby offering a highly practical solution for real-world deployment. Experimental evaluation in a real-world home environment yields a median AoA estimation error of 2.2 degree and a median localization error of 1.25m, demonstrating the feasibility and effectiveness of audio-based localization for enabling context-aware, privacy-preserving ambient intelligence.},
  booktitle = {Proceedings of the International Workshop on Environmental Sensing Systems for Smart Cities (EnvSys '25), co-located with MobiSys 2025},
  month     = June,
  year      = {2025},
  location  = {Anaheim, CA, USA},
  pages     = {1--6},
  publisher = {ACM},
  address   = {New York, NY, USA},
  doi       = {10.1145/3742460.3742984},
  isbn      = {979-8-4007-1986-8},
  arxiv     = {2508.16908},
  slides    = {https://drive.google.com/file/d/1Iqf1Drt0oOLicnqPs1ARRC76bgIXpH2j/view?usp=sharing}
}

